# .NET
backend/**/bin/
backend/**/obj/
backend/src/Datamint.API/logs/
backend/src/Datamint.API/uploads/
scripts/SqlGrant/bin/
scripts/SqlGrant/obj/
*.user

# Real backend config - contains live secrets (DB connection string, JWT
# secret, Google/OpenAI/Claude/Razorpay/SMTP credentials). Never commit this.
# See appsettings.json.example for the placeholder shape. Same for the two
# environment-specific overrides - see appsettings.QA.json.example /
# appsettings.Production.json.example.
backend/src/Datamint.API/appsettings.json
backend/src/Datamint.API/appsettings.QA.json
backend/src/Datamint.API/appsettings.Production.json

# Angular / Node
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Local HTTPS dev cert (exported from the trusted ASP.NET Core dev cert so
# ng serve and the API share one cert) - machine-specific, never commit.
frontend/.certs/

# Editor / OS
.vs/
.vscode/
*.swp
.DS_Store

# Claude Code local-machine settings (permission grants etc.) - not shared
.claude/settings.local.json
.claude/scheduled_tasks.lock

# azd per-environment state - contains provisioned secret values (JWT, SMTP,
# Claude/OpenAI keys) and machine-specific env selection. The deployment PLAN
# (.azure/deployment-plan.md) is deliberately tracked; only the environment
# subfolders azd itself creates are excluded here.
.azure/*/
!.azure/deployment-plan.md
